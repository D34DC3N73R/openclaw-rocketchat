{
  "name": "@d34dc3n73r/openclaw-rocketchat",
  "version": "0.4.0",
  "description": "OpenClaw Rocket.Chat channel plugin — Maintained fork by D34DC3N73R",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D34DC3N73R/openclaw-rocketchat.git"
  },
  "homepage": "https://github.com/D34DC3N73R/openclaw-rocketchat#readme",
  "bugs": {
    "url": "https://github.com/D34DC3N73R/openclaw-rocketchat/issues"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build && npm run manifest:schema",
    "manifest:schema": "node --import tsx scripts/generate-manifest-schema.ts",
    "lint": "echo 'lint: not configured'",
    "test": "node --import tsx --test test/**/*.test.ts",
    "lint:lockfile": "lockfile-lint"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "zod": "4.3.6",
    "lockfile-lint": "5.0.0"
  },
  "dependencies": {
    "openclaw": "2026.4.23",
    "typebox": "1.1.28",
    "ws": "8.20.0"
  },
  "overrides": {
    "tar": "7.5.13",
    "cmake-js": "7.4.0"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./setup-entry.ts",
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "compat": {
      "pluginApi": "^2026.4.23"
    },
    "build": {
      "openclawVersion": "2026.4.23"
    },
    "channel": {
      "id": "rocketchat",
      "label": "Rocket.Chat",
      "selectionLabel": "Rocket.Chat (plugin)",
      "docsPath": "/channels/rocketchat",
      "docsLabel": "rocketchat",
      "blurb": "self-hosted team chat; install the plugin to enable.",
      "order": 66
    },
    "install": {
      "npmSpec": "@alexwoo-awso/openclaw-rocketchat",
      "localPath": "extensions/rocketchat",
      "defaultChoice": "npm"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
